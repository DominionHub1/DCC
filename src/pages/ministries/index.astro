---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import MinistryGrid from '../../components/MinistryGrid.astro';
import FourFsGrid from '../../components/FourFsGrid.astro';

// Cross-links from each F to where DCC lives it out
const related: Record<string, { href: string; label: string }[]> = {
  faith: [{ href: '/messages', label: 'Watch recent messages' }, { href: '/new-here?step=Serve%20Class#next-steps-form', label: 'Join Serve Class' }],
  family: [{ href: '#ministries', label: 'Explore our ministries' }, { href: '/ministries/children', label: "Children's Ministry" }],
  finance: [{ href: '/ministries/community/career-development', label: 'Career & Development' }, { href: '/give', label: 'Generosity and giving' }],
  future: [{ href: '/ministries/community/career-development', label: 'Mentoring and career support' }, { href: '/ministries/youth', label: 'Youth Ministry' }],
};
---
<Base title="Ministries" description="The Children, Youth, Men, Women and Community ministries of Dominion Christian Connections, Peterborough, and the Four F's: Faith, Family, Finance and Future.">
  <PageHero title="Ministries" eyebrow="Grow and belong" lead="Find your place, use your gifts and grow together, as we believe God to transform every area of life." crumbs={[]} />

  <!-- Ministries -->
  <section class="section" id="ministries" aria-labelledby="ministries-h">
    <div class="container">
      <SectionHead id="ministries-h" title="Our Ministries" eyebrow="Find your place" intro="Use your gifts, grow in faith and build real friendships in one of our ministries." />
      <MinistryGrid variant="tiles" />
    </div>
  </section>
  <!-- The Four F's -->
  <section class="section section--cream" id="four-fs" aria-labelledby="four-fs-h">
    <div class="container">
      <SectionHead id="four-fs-h" title="The Four F's" intro="We believe faith should transform every area of life. These are the four areas DCC is believing God to impact in the life of every member." />
      <FourFsGrid links={related} />
    </div>
  </section>

</Base>
