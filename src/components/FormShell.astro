---
import site from '../data/site.json';
import { jotformUrl, jotformId, withPrefill, type FormName } from '../lib/forms';
interface Props {
  form: FormName;
  /** Accessible name for the embedded form, e.g. "Contact form". */
  title: string;
  /** Fixed values to fill in, keyed by the Jotform field's unique name, e.g. { ministry: 'Youth' }. */
  prefill?: Record<string, string>;
  /** Page link parameters to pass on to the form: { pageParam: jotformFieldName }, e.g. { help: 'area' }. */
  forward?: Record<string, string>;
}
const { form, title, prefill = {}, forward } = Astro.props;
const base = jotformUrl(form);
const src = base && withPrefill(base, prefill);
const id = jotformId(base);
---
{src ? (
  <iframe
    class="jotform-embed"
    id={id ? `JotFormIFrame-${id}` : undefined}
    title={title}
    src={src}
    data-jotform
    data-jotform-forward={forward ? JSON.stringify(forward) : undefined}
    loading="lazy"
    allow="geolocation; microphone; camera; fullscreen"
  ></iframe>
) : (
  <div class="form-pending">
    <p><strong>Our online form is being set up.</strong> In the meantime, we'd love to hear from you:</p>
    <div class="btn-row">
      <a class="btn btn--gold btn--sm" href={`mailto:${site.contact.email}`}>Email {site.contact.email}</a>
      <a class="btn btn--outline btn--sm" href={`tel:${site.contact.phone}`}>Call {site.contact.phoneDisplay}</a>
    </div>
  </div>
)}
