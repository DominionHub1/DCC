---
import Icon from './Icon.astro';
---
<section class="section section--tight" aria-labelledby="need-prayer">
  <div class="container">
    <div class="prayer-band reveal">
      <div class="prayer-band__icon"><Icon name="hand-heart" size={48} /></div>
      <div>
        <h2 id="need-prayer">Need Prayer?</h2>
        <p>Whatever you're facing, you don't have to face it alone. We'd be honoured to pray with you, and you can ask anonymously.</p>
      </div>
      <a class="btn btn--gold" href="/ministries/community/prayer">Submit a Prayer Request <Icon name="arrow-right" size={18} /></a>
    </div>
  </div>
</section>
