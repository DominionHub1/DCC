---
interface Props {
  id: string; name?: string; label: string; type?: 'text' | 'email' | 'tel' | 'date'; required?: boolean; hint?: string;
  as?: 'input' | 'textarea' | 'select'; options?: string[]; autocomplete?: astroHTML.JSX.InputHTMLAttributes['autocomplete']; placeholder?: string; preselect?: string; spokenName?: string;
}
const { id, name = id, label, type = 'text', required = false, hint, as = 'input', options = [], autocomplete, placeholder, preselect, spokenName } = Astro.props;
const describedBy = [hint && `${id}-hint`, `${id}-error`].filter(Boolean).join(' ');
const common = { id, name, required, 'aria-describedby': describedBy, 'data-name': spokenName ?? label.toLowerCase() };
---
<div class="field">
  <label for={id}>{label}{required ? <span class="req" aria-hidden="true"> *</span> : <span class="muted"> (optional)</span>}</label>
  {hint && <span class="hint" id={`${id}-hint`}>{hint}</span>}
  {as === 'textarea' && <textarea {...common} placeholder={placeholder}></textarea>}
  {as === 'select' && (
    <select {...common} data-preselect={preselect}>
      <option value="">Please choose…</option>
      {options.map((o) => <option value={o}>{o}</option>)}
    </select>
  )}
  {as === 'input' && <input {...common} type={type} autocomplete={autocomplete} placeholder={placeholder} />}
  <span class="error" id={`${id}-error`} role="alert"></span>
</div>
