---
import HeroVideo, { type HeroVideoConfig } from './HeroVideo.astro';
interface Props { title: string; lead?: string; eyebrow?: string; image?: string; imagePosition?: string; video?: HeroVideoConfig; videoPauseControl?: boolean; centered?: boolean; oneLineTitle?: boolean; crumbs?: { href: string; label: string }[] }
const { title, lead, eyebrow, image, imagePosition = 'center', video, videoPauseControl = true, centered = false, oneLineTitle = false, crumbs = [] } = Astro.props;
---
<section class:list={['page-hero', image && 'page-hero--image', centered && 'page-hero--centered', oneLineTitle && 'page-hero--oneline']}>
  {image && <div class="page-hero__bg"><img src={image} alt="" fetchpriority="high" style={`object-position:${imagePosition}`} /></div>}
  {image && video && <HeroVideo video={video} pauseControl={videoPauseControl} />}
  <div class="container">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href="/">Home</a></li>
          {crumbs.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
          <li aria-current="page">{title}</li>
        </ol>
      </nav>
    )}
    {eyebrow && <div class="eyebrow">{eyebrow}</div>}
    {Astro.slots.has('title') ? <h1 aria-label={title}><slot name="title" /></h1> : <h1>{title}</h1>}
    {lead && <p>{lead}</p>}
    <slot />
  </div>
</section>
