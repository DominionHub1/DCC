---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
// `tiles`: large photo tiles with the ministry name over the image (Ministries page).
interface Props { variant?: 'cards' | 'tiles' }
const { variant = 'cards' } = Astro.props;
const ministries = (await getCollection('ministries', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
{variant === 'tiles' ? (
  <div class="ministry-tiles">
    {ministries.map((m) => (
      <a class="ministry-tile reveal" href={`/ministries/${m.id}`}>
        {m.data.image
          ? <img src={m.data.image} alt="" loading="lazy" />
          : <span class="ministry-tile__fallback" aria-hidden="true"><Icon name={m.data.icon} size={96} /></span>}
        <span class="ministry-tile__text">
          <span class="ministry-tile__name">{m.data.name}</span>
          <span class="ministry-tile__tag">{m.data.tagline}</span>
        </span>
      </a>
    ))}
  </div>
) : (
  <div class="grid grid-5">
    {ministries.map((m) => (
      <a class="card ministry-card reveal" href={`/ministries/${m.id}`}>
        <div class="card__media">
          {m.data.image ? <img src={m.data.image} alt={m.data.imageAlt ?? ''} loading="lazy" /> : <div class="media-fallback"><Icon name={m.data.icon} size={44} /></div>}
        </div>
        <div class="card__body">
          <h3>{m.data.name}</h3>
          <p>{m.data.tagline}</p>
        </div>
      </a>
    ))}
  </div>
)}
